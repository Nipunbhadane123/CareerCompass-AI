# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CareerCompass AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Use SQLite for zero-config local development, or PostgreSQL for production:
DATABASE_URL=sqlite:///./careercompass.db
# PostgreSQL example:
# DATABASE_URL=postgresql://careercompass:secretpassword@localhost:5432/careercompass_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# AI Configuration
# Options: "gemini" or "deterministic" (mock/offline fallback)
AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Admin Seed
FIRST_SUPERUSER_EMAIL=admin@careercompass.ai
FIRST_SUPERUSER_PASSWORD=AdminPassword123!
